{
  "name": "clhh-mv",
  "version": "1.1.4",
  "private": true,
  "description": "CLHH MV 创作",
  "main": "electron/main.cjs",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.cjs",
    "verify": "node scripts/verify.cjs",
    "start": "npm run build:renderer && node scripts/prepare.cjs && NODE_ENV=production electron .",
    "pack:mac": "npm run build:renderer && npm run verify && node scripts/prepare.cjs && electron-builder --mac dmg --arm64 --publish never",
    "check:status": "node scripts/check-status.cjs",
    "check:merge": "node scripts/check-merge.cjs"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "com.clhh.crystal.macos",
    "productName": "CLHH MV 创作",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "CLHH MV 创作",
      "artifactName": "CLHH-MV-1.1.4-macOS-arm64.${ext}"
    },
    "buildVersion": "1.1.419",
    "asarUnpack": [
      "dist/assets/*.mp4"
    ]
  },
  "engines": {
    "node": ">=22 <23"
  }
}
